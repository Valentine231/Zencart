generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  role      Role     @default(USER)
  orders    Order[]
}

model Product {
  id          String      @id @default(uuid())
  title       String
  description String
  price       Float
  image       String
  category    Category
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id               String       @id @default(uuid())
  userId           String
  total            Float
  createdAt        DateTime     @default(now())
  updatedAt        DateTime?    @updatedAt
  dispatchVideoUrl String?
  escrowStatus     EscrowStatus @default(HELD)
  isPod            Boolean      @default(false)
  paymentReference String?      @unique
  transactionRef   String?
  status           OrderStatus  @default(PENDING)
  disputes         Dispute[]
  user             User         @relation(fields: [userId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  reason      String
  evidenceUrl String?
  status      DisputeStatus @default(OPEN)
  resolution  String?
  aiVerdict   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WhatsappMessage {
  id             String   @id @default(uuid())
  phoneNumber    String
  messageType    String
  content        String
  mediaUrl       String?
  waMessageId    String   @unique
  deliveryStatus String   @default("sent")
  createdAt      DateTime @default(now())
}

enum Category {
  MEN
  WOMEN
  ACCESSORIES
  FOOTWEAR
  GLASSES
  GADGETS
}

enum OrderStatus {
  PENDING
  PAID
}

enum EscrowStatus {
  HELD
  RELEASED
  DISPUTED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REFUNDED
  REJECTED
}

enum Role {
  USER
  ADMIN
}
